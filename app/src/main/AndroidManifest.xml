<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://android.com">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="KIBER RUSSIA"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.MyLauncher">

        <!-- 1. Главный экран (Часы и кнопка перехода к серверам) -->
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 2. Экран выбора серверов (Сервер Kalimangi) -->
        <activity
            android:name=".ServersActivity"
            android:exported="false" />

        <!-- 3. Экран авторизации (Ввод никнейма и пароля) -->
        <activity
            android:name=".LoginActivity"
            android:exported="false" />

    </application>

</manifest>